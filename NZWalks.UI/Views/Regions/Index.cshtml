@model IEnumerable<NZWalks.UI.Models.DTO.RegionDTO>
@{
    ViewData["Title"] = "Explore regions";
}

<section class="page-hero page-hero-green">
    <div class="container page-hero-inner">
        <div><span class="eyebrow eyebrow-light">THE LAND OF THE LONG WHITE CLOUD</span><h1>Find your <em>somewhere.</em></h1></div>
        <p>Every region has its own rhythm. Pick a direction and see where the track takes you.</p>
    </div>
</section>

<section class="container listing-section">
    <div class="listing-toolbar">
        <div><span class="eyebrow">EXPLORE AOTEAROA</span><h2>Regions <span class="count-pill">@Model.Count()</span></h2></div>
        <a class="btn btn-forest" asp-action="Add">Add a region <span aria-hidden="true">+</span></a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">⌁</span>
            <h3>No regions to show just yet.</h3>
            <p>Check that the API is running, or come back when the map has grown.</p>
            <a class="text-link" asp-controller="Home" asp-action="Index">Back to discover <span aria-hidden="true">↗</span></a>
        </div>
    }
    else
    {
        <div class="region-grid">
            @foreach (var region in Model)
            {
                <a class="region-card" asp-action="Details" asp-route-id="@region.Id">
                    <div class="region-card-image">
                        <img src="@(string.IsNullOrWhiteSpace(region.RegionImageUrl) ? Url.Content("~/images/alpine-lake.jpg") : region.RegionImageUrl)"
                             alt="@region.Name landscape" loading="lazy" />
                        <span class="region-code">@region.Code</span>
                    </div>
                    <div class="region-card-body">
                        <div><span class="eyebrow">DISCOVER</span><h3>@region.Name</h3></div>
                        <span class="card-arrow" aria-hidden="true">↗</span>
                    </div>
                </a>
            }
        </div>
    }
</section>
