@model ErrorViewModel
@{
    ViewData["Title"] = "A little detour";
}

<section class="error-page">
    <div class="container">
        <span class="eyebrow">A LITTLE DETOUR</span>
        <h1>That wasn’t<br />part of the <em>plan.</em></h1>
        <p>Something went wrong while loading this page. Your next step is still easy.</p>
        @if (Model.ShowRequestId)
        {
            <p class="request-id">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-forest" asp-controller="Home" asp-action="Index">Back to the trailhead <span aria-hidden="true">↗</span></a>
    </div>
</section>
