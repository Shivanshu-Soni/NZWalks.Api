@model NZWalks.UI.Models.WalkViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-field">
    <label asp-for="Name">Walk name</label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Hooker Valley Track" />
    <span asp-validation-for="Name" class="field-error"></span>
</div>
<div class="form-field">
    <label asp-for="Description">A little about it</label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="What makes this walk worth taking?"></textarea>
    <span asp-validation-for="Description" class="field-error"></span>
</div>
<div class="form-row">
    <div class="form-field">
        <label asp-for="LenghtInkm">Distance <span class="optional-label">km</span></label>
        <input asp-for="LenghtInkm" class="form-control" type="number" min="0.1" max="50" step="0.1" placeholder="8.5" />
        <span asp-validation-for="LenghtInkm" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="DifficultyId">Difficulty</label>
        <select asp-for="DifficultyId" class="form-select">
            <option value="">Choose a pace</option>
            @foreach (var difficulty in Model.Difficulties)
            {
                <option value="@difficulty.Id">@difficulty.Name</option>
            }
        </select>
        <span asp-validation-for="DifficultyId" class="field-error"></span>
    </div>
</div>
<div class="form-field">
    <label asp-for="RegionId">Region</label>
    <select asp-for="RegionId" class="form-select">
        <option value="">Choose a region</option>
        @foreach (var region in Model.Regions)
        {
            <option value="@region.Id">@region.Name</option>
        }
    </select>
    <span asp-validation-for="RegionId" class="field-error"></span>
</div>
<div class="form-field">
    <label asp-for="WalkImageUrl">Image URL <span class="optional-label">optional</span></label>
    <input asp-for="WalkImageUrl" class="form-control" placeholder="https://…" />
    <span asp-validation-for="WalkImageUrl" class="field-error"></span>
</div>
