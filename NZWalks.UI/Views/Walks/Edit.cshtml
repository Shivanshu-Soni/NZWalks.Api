@model NZWalks.UI.Models.WalkViewModel
@{
    ViewData["Title"] = "Edit walk";
}

<section class="form-page">
    <div class="container form-layout">
        <div class="form-aside">
            <a class="back-link" asp-action="Details" asp-route-id="@Model.Id">← Back to walk</a>
            <span class="eyebrow">KEEP THE DETAILS FRESH</span>
            <h1>Make it<br /><em>just right.</em></h1>
            <p>Update the details so the next person knows what to expect.</p>
            <img src="~/images/alpine-lake.jpg" alt="A quiet alpine landscape" />
        </div>
        <div class="form-panel">
            <h2>Edit @Model.Name</h2>
            <p class="form-subtitle">Update this track’s details.</p>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input asp-for="Id" type="hidden" />
                <partial name="_WalkFields" model="Model" />
                <div class="form-actions">
                    <a class="btn btn-outline-forest" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                    <button class="btn btn-forest" type="submit">Save changes <span aria-hidden="true">↗</span></button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
